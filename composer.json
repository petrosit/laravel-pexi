{
    "name": "pexi/laravel",
    "description": "Laravel exception reporting client for Pexi.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Pexi\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pexi\\Laravel\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pexi\\Laravel\\PexiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
